# Aiven Console > MySQL 서비스 > Connection information에서 확인합니다.
# 실제 비밀번호는 .env에만 입력합니다. .env와 ca.pem은 공유하지 않습니다.
MYSQL_HOST=
MYSQL_PORT=
MYSQL_USER=avnadmin
MYSQL_PASSWORD=
MYSQL_DATABASE=defaultdb
MYSQL_CA_PATH=ca.pem

# Jetson의 고유 장치 이름과 전송 대기 로그 보관 파일
DEVICE_ID=jetson-orin-nano-01
OUTBOX_PATH=jetson_log_outbox.sqlite3

# HTML 서버. 기본값은 로컬 접속만 허용합니다. (app.py를 직접 실행할 때만 사용.
# convey_vision.py는 파일 안의 WEB_HOST='0.0.0.0'으로 같은 Wi-Fi 접속을 허용합니다.)
HOST=127.0.0.1
PORT=5080

# 대시보드 버튼 비밀번호. 값이 있으면 종료·DB 연동 버튼을 누를 때 묻습니다. 영상·로그 보기는 비밀번호 없이 열립니다.
# 같은 Wi-Fi나 인터넷(start_tunnel.sh)으로 열 때는 반드시 넣으세요.
# 비워 두면 주소를 아는 누구나 종료 버튼으로 벨트를 멈출 수 있습니다.
DASHBOARD_PASSWORD=

# 기존 YuNet 코드가 송출하는 MJPEG 주소가 있으면 입력합니다.
# 미지정 시 HTML에서 로컬 USB 카메라를 선택해 볼 수 있습니다.
CAMERA_STREAM_URL=
